{
  "name": "agroprognoz",
  "productName": "АгроПрогноз",
  "version": "1.0.0",
  "description": "АгроПрогноз — прогноз погоды для кукурузы",
  "author": "Igorr112323",
  "license": "MIT",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/dev-server.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "protect": "node scripts/build-renderer.mjs",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.7.0",
    "jsdom": "^30.0.1",
    "leaflet": "1.9.4",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.4",
    "sql.js": "1.14.2",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "build": {
    "appId": "com.agroprognoz.corn",
    "productName": "АгроПрогноз",
    "asar": true,
    "asarUnpack": [
      "**/*.wasm"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "calculations/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AgroPrognoz-${version}-portable.${ext}"
    }
  }
}
